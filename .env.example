# ═══════════════════════════════════════════════
# Narratix Lab — Environment Variables
# Copy this file to .env.local and fill in values
# ═══════════════════════════════════════════════

# ─── Supabase (Auth + Database) ───────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Anthropic (Claude AI) ────────────────────
# Any value starting with "your_" or "placeholder" is treated as NOT configured.
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── OpenAI (Fallback AI + Future Whisper) ─────
OPENAI_API_KEY=your_openai_api_key

# ─── DEMO MODE (Stage 7) ───────────────────────────────
# When true, the analyze pipeline serves a curated, schema-valid gold-standard
# report at zero API cost — the full UX works every time (ideal for a beta demo).
# The live provider pipeline stays wired; set to false to use real per-input AI.
DEMO_MODE=true

# ─── OpenRouter (live-AI provider) ─────────────────────
# Paste your key here and the pipeline works immediately (locally and on Vercel).
OPENROUTER_API_KEY=your_openrouter_api_key
# Model is env-driven. Free models (nemotron/gemma) are too slow or rate-limited
# to produce a valid report; gpt-4o-mini is the cheapest capable model, and
# gpt-4o gives the best quality (both need OpenRouter credit).
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_MAX_OUTPUT_TOKENS=16000
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# --- Request lifecycle (Stage 6B) ---
# Hard per-request wall-clock ceiling. Node's fetch() has NO default timeout,
# so without this a stalled generation hangs the SSE stream forever. The free
# Nemotron model can take ~160s for a full report, so raise this (e.g. 200000)
# ONLY if you stay on the free model; a paid model completes well under 90s.
# OPENROUTER_TIMEOUT_MS=90000
# Transient-failure retries (timeout/network/429/503/5xx) with exp. backoff:
# OPENROUTER_MAX_ATTEMPTS=2
# OPENROUTER_RETRY_BASE_DELAY_MS=1000
# Optional attribution headers shown on your OpenRouter dashboard:
# OPENROUTER_HTTP_REFERER=https://your-site.example.com
# OPENROUTER_X_TITLE=Narratix Lab

# ─── AI Models & Provider Order (optional overrides) ──
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o
# AI_PROVIDER_ORDER=anthropic,openai,openrouter
# PRIMARY_AI_PROVIDER promotes one provider to the front of the waterfall.
# Accepted: anthropic | openai | openrouter
# PRIMARY_AI_PROVIDER=openrouter
# ANTHROPIC_MAX_OUTPUT_TOKENS=16000
# OPENAI_MAX_OUTPUT_TOKENS=16000

# ─── Cloudinary (Future Video Upload) ──────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Stripe (Payments) ────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_PRO_PRICE_ID=your_stripe_pro_plan_price_id
STRIPE_TEAM_PRICE_ID=your_stripe_team_plan_price_id

# ─── App Config ───────────────────────────────
# REQUIRED in production: drives the CORS allow-origin header, OAuth redirect
# targets and Stripe return URLs. If unset it falls back to localhost:3000 and
# production requests are rejected.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional extra trusted hostnames (comma-separated), added to the built-in set
# of localhost, narratixlab.com, www.narratixlab.com, NEXT_PUBLIC_APP_URL and
# the hostnames Vercel injects. Requests on any other Host are rejected.
# Example: ALLOWED_HOSTS=staging.narratixlab.com,narratix-lab.vercel.app
ALLOWED_HOSTS=
